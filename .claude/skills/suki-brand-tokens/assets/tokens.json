{
  "$comment": "Suki — tokens del sistema visual. Derivado del Manual de Marca v1.0 (03-visual.md). Esta paleta es solo para piezas propias de Suki; el software entregado a clientes usa los colores del cliente (skill suki-client-ui).",
  "version": "1.0",
  "color": {
    "brand": {
      "action":    { "value": "#06D6A0", "rgb": [6, 214, 160],   "verbo": "Construir",   "familia": "C · Producto digital",      "rol": "Color de acción: botones, enlaces, estados activos" },
      "adapt":     { "value": "#8338EC", "rgb": [131, 56, 236],  "verbo": "Adaptar",     "familia": "A · Sistemas de gestión",   "rol": "Acento" },
      "integrate": { "value": "#FFBE0B", "rgb": [255, 190, 11],  "verbo": "Integrar",    "familia": "B · Automatización e IA",   "rol": "Acento" },
      "scale":     { "value": "#FF006E", "rgb": [255, 0, 110],   "verbo": "Escalar",     "familia": "D · Datos e inteligencia",  "rol": "Acento" },
      "evolve":    { "value": "#3A86FF", "rgb": [58, 134, 255],  "verbo": "Evolucionar", "familia": "E · Suki Labs",             "rol": "Acento" }
    },
    "neutral": {
      "base":          { "value": "#0D0D0D", "uso": "Fondo base" },
      "surface-1":     { "value": "#141414", "uso": "Superficie nivel 1" },
      "surface":       { "value": "#1A1A1A", "uso": "Superficie nivel 2, tarjetas" },
      "elevated":      { "value": "#242424", "uso": "Superficie elevada, hover" },
      "border-strong": { "value": "#333333", "uso": "Borde marcado" },
      "border":        { "value": "#4D4D4D", "uso": "Borde sutil, divisores" },
      "disabled":      { "value": "#737373", "uso": "Deshabilitado, decorativo", "contraste_sobre_base": 4.1, "apto_texto": false },
      "text-subtle":   { "value": "#999999", "uso": "Texto terciario, pies de foto", "contraste_sobre_base": 6.8, "apto_texto": true },
      "text-muted":    { "value": "#B3B3B3", "uso": "Texto secundario", "contraste_sobre_base": 9.3, "apto_texto": true },
      "text":          { "value": "#CCCCCC", "uso": "Texto principal. Gris del logotipo", "contraste_sobre_base": 12.1, "apto_texto": true },
      "heading":       { "value": "#E6E6E6", "uso": "Títulos", "contraste_sobre_base": 15.6, "apto_texto": true },
      "light":         { "value": "#F5F5F5", "uso": "Fondo del modo claro" },
      "white":         { "value": "#FFFFFF", "uso": "Texto sobre color, superficies claras", "contraste_sobre_base": 19.4, "apto_texto": true }
    },
    "functional": {
      "$comment": "Existen solo dentro de interfaces. El estado nunca se comunica solo con color: siempre ícono y texto.",
      "error":   { "dark": "#FF3B30", "light": "#C62828" },
      "success": { "dark": "#06D6A0", "light": "#06D6A0" },
      "warning": { "dark": "#FFBE0B", "light": "#FFBE0B" },
      "info":    { "dark": "#3A86FF", "light": "#3A86FF" }
    },
    "theme": {
      "dark": { "$comment": "Modo oficial", "bg": "#0D0D0D", "surface": "#1A1A1A", "text": "#CCCCCC", "text-muted": "#B3B3B3", "border": "#4D4D4D", "action": "#06D6A0", "on-action": "#0D0D0D" },
      "light": { "$comment": "Impresión, documentos, correo", "bg": "#F5F5F5", "surface": "#FFFFFF", "text": "#0D0D0D", "text-muted": "#4D4D4D", "border": "#CCCCCC", "action": "#06D6A0", "on-action": "#0D0D0D" }
    },
    "rules": [
      "Sobre #06D6A0 y sobre #FFBE0B el texto es siempre #0D0D0D. Blanco da 1,9:1 y 1,7:1.",
      "#8338EC no se usa como texto sobre fondo oscuro (3,5:1). Va como relleno con blanco encima.",
      "Mínimo WCAG AA: 4,5:1 en texto normal, 3:1 en texto grande y elementos de interfaz.",
      "Proporción 70 % neutros oscuros / 20 % verde / 10 % resto de acentos, verificada por sección.",
      "Un solo color de acento por composición. Única excepción: la fila completa de los cinco puntos.",
      "Sin degradados. Sin colores fuera de la paleta. Sin acentos como fondo de sección completa."
    ]
  },
  "typography": {
    "family": {
      "brand": { "value": "Montserrat", "fallback": ["Arial", "sans-serif"], "uso": "Logotipo y titulares de marca de hasta cinco palabras" },
      "body":  { "value": "Inter", "fallback": ["Segoe UI", "Helvetica", "Arial", "sans-serif"], "uso": "Todo lo demás", "pesos": [400, 500, 600, 700] },
      "mono":  { "value": "JetBrains Mono", "fallback": ["Consolas", "Courier New", "monospace"], "uso": "Código, datos, etiquetas técnicas, numeración" }
    },
    "scale": {
      "display":  { "size": 48, "line": 56, "family": "brand", "weight": 600, "tracking": "-2%" },
      "h1":       { "size": 36, "line": 44, "family": "body", "weight": 700, "tracking": "-1%" },
      "h2":       { "size": 30, "line": 38, "family": "body", "weight": 600, "tracking": "-1%" },
      "h3":       { "size": 24, "line": 32, "family": "body", "weight": 600 },
      "h4":       { "size": 20, "line": 28, "family": "body", "weight": 600 },
      "body-lg":  { "size": 18, "line": 30, "family": "body", "weight": 400 },
      "body":     { "size": 16, "line": 26, "family": "body", "weight": 400 },
      "body-sm":  { "size": 14, "line": 22, "family": "body", "weight": 400 },
      "caption":  { "size": 12, "line": 18, "family": "body", "weight": 400 },
      "label":    { "size": 12, "line": 16, "family": "body", "weight": 600, "transform": "uppercase", "tracking": "+6%" },
      "mono":     { "size": 14, "line": 22, "family": "mono", "weight": 400 }
    },
    "measure": "65ch",
    "align": "left"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64, "24": 96, "32": 128,
    "$comment": "No existen valores intermedios. Secciones 96–128, bloques 48–64, componentes 24–32, elementos pequeños 8–16." },
  "grid": {
    "desktop": { "columns": 12, "gutter": 24, "margin": [64, 120] },
    "tablet":  { "columns": 8,  "gutter": 24, "margin": [48, 48] },
    "mobile":  { "columns": 4,  "gutter": 16, "margin": [20, 20] },
    "container-max": 1280,
    "content-max": 1200
  },
  "radius": { "default": 0, "box": "8%", "$comment": "Radio 0 en todo. Dos excepciones: los cinco puntos (círculos) y la cajita del logotipo." },
  "border": { "width": 1, "zone": 4 },
  "elevation": { "$comment": "Sin sombras, sin resplandores, sin degradados, sin glassmorphism. La profundidad es contraste de superficie + borde de 1px." },
  "motion": {
    "fast": "150ms", "base": "250ms", "max": "400ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "dot-stagger": "60ms",
    "$comment": "Se animan opacidad y posición. El color nunca es el único cambio. Sin parpadeos, rebotes ni rotaciones continuas. Respetar prefers-reduced-motion."
  }
}
